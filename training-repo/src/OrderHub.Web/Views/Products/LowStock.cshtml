@model LowStockViewModel
@{
    ViewData["Title"] = "低庫存商品";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">低庫存商品</h1>
    <div class="btn-group" role="group" aria-label="商品檢視">
        <a class="btn btn-outline-secondary" asp-action="Index">全部商品</a>
        <a class="btn btn-primary" asp-action="LowStock" asp-route-threshold="@Model.Threshold">低庫存</a>
    </div>
</div>

<form method="get" asp-action="LowStock" class="row g-2 align-items-end mb-3">
    <div class="col-auto">
        <label asp-for="Threshold" class="form-label"></label>
        <input asp-for="Threshold" class="form-control" type="number" min="1" />
        <span asp-validation-for="Threshold" class="text-danger"></span>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">查詢</button>
    </div>
    <div class="col-12">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    </div>
</form>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-warning">請修正門檻後再查詢。</div>
}
else if (Model.Products.Count == 0)
{
    <div class="alert alert-info">沒有符合門檻的低庫存商品。</div>
}
else
{
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>SKU</th>
                <th>名稱</th>
                <th class="text-end">現有庫存</th>
                <th class="text-end">近 30 天售出</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in Model.Products)
            {
                <tr class="@(product.HighlightLowStock ? "table-danger" : null)">
                    <td>@product.Sku</td>
                    <td>@product.Name</td>
                    <td class="text-end">@product.StockQuantity</td>
                    <td class="text-end">@product.SoldLast30Days</td>
                </tr>
            }
        </tbody>
    </table>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
